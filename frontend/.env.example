# Copy this file to frontend/.env and fill in your real values.
# frontend/.env is git-ignored. NEVER commit real secrets.

# Pinata JWT (required for real IPFS uploads). Get it from:
# https://app.pinata.cloud/developers/api-keys  (free tier is enough)
VITE_PINATA_JWT=YOUR_PINATA_JWT

# Public IPFS gateway (defaults to Pinata/IPFS public gateways if empty)
VITE_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional local IPFS-compatible dev server for testing without Pinata.
# VITE_LOCAL_IPFS_URL=http://127.0.0.1:9099

# RPC URL for the frontend provider (Sepolia). Use the same endpoint as
# SEPOLIA_RPC_URL in the root .env (Infura/Alchemy).
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Deployed FileRegistry contract address.
# This is written automatically by `npx hardhat run scripts/deploy.js`.
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Chain id of the network the DApp expects: 11155111 = Sepolia, 1337 = local.
VITE_CHAIN_ID=11155111
